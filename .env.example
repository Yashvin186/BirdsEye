# Birds Eye Environment Configuration

# Server Host and Port
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Directory for projects, frames, point clouds, and mesh outputs
# Defaults to ./workspace relative to project root if left unset
# BIRDS_EYE_WORKSPACE=./workspace

# Photogrammetry & Video Processing Tools
# If available in system PATH, 'colmap' and 'ffmpeg' will be auto-detected.
# You can also set explicit executable paths:
# COLMAP_EXE=bin/colmap/COLMAP-3.9.1-windows-cuda/COLMAP.bat
# FFMPEG_EXE=ffmpeg

# Upload Constraints
MAX_UPLOAD_SIZE_MB=1024
MAX_VIDEO_DURATION_SEC=1200
